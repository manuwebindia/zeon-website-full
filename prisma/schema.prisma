// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Blog {
  id               String    @id @default(cuid())
  title            String
  slug             String    @unique
  seoTitle         String?   @map("seo_title")
  seoDescription   String?   @map("seo_description")
  featuredImage    String?   @map("featured_image")
  featuredImageAlt String?   @map("featured_image_alt")
  bannerImage      String?   @map("banner_image")
  bannerImageAlt   String?   @map("banner_image_alt")
  content          Json      // Array of content blocks
  excerpt          String?
  status           String    @default("draft") // "draft" | "published"
  allowIndexing    Boolean   @default(true) @map("allow_indexing")
  publishedAt      DateTime? @map("published_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  // Phase 1 — Taxonomy & Focus Keyword
  focusKeyword     String?   @map("focus_keyword")
  category         String?
  tags             Json?     // String array e.g. ["seo","web design"]

  // Phase 3 — Social Media / OG Overrides
  ogTitle          String?   @map("og_title")
  ogDescription    String?   @map("og_description")
  ogImage          String?   @map("og_image")
  canonicalUrl     String?   @map("canonical_url")

  // Phase 4 — Schema Markup
  articleType      String?   @default("Article") @map("article_type") // legacy primary type
  schemaFaqItems   Json?     @map("schema_faq_items")    // legacy FAQ items
  schemaHowToSteps Json?     @map("schema_how_to_steps") // legacy HowTo steps
  schemaBlocks     Json?     @map("schema_blocks")       // [{ type, faqItems?, howToSteps? }]

  wpPostId         Int?      @unique @map("wp_post_id")

  @@map("blogs")
}

// ── CMS Pages (imported WP pages, non-frozen routes) ─────────────────────────
model Page {
  id             String    @id @default(cuid())
  title          String
  slug           String    @unique
  content        Json
  excerpt        String?   @db.Text
  status         String    @default("draft")
  seoTitle       String?   @map("seo_title")
  seoDescription String?   @map("seo_description") @db.Text
  featuredImage  String?   @map("featured_image")
  allowIndexing  Boolean   @default(true) @map("allow_indexing")
  wpPostId       Int?      @unique @map("wp_post_id")
  publishedAt    DateTime? @map("published_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@index([status])
  @@map("pages")
}

// ── RBAC: Groups (custom, user-defined — no hardcoded seeds) ─────────────────
model Group {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  permissions Json     @default("[]")   // ["blogs.view","blogs.create",...]
  createdAt   DateTime @default(now())  @map("created_at")
  updatedAt   DateTime @updatedAt       @map("updated_at")
  users       User[]

  @@map("groups")
}

// ── RBAC: Users (DB-backed, managed via admin UI) ────────────────────────────
model User {
  id           String    @id @default(cuid())
  username     String    @unique
  email        String?   @unique
  displayName  String?   @map("display_name")
  passwordHash String    @map("password_hash")
  avatarUrl    String?   @map("avatar_url")
  isActive     Boolean   @default(true) @map("is_active")
  groupId      String    @map("group_id")
  group        Group     @relation(fields: [groupId], references: [id])
  lastLoginAt  DateTime? @map("last_login_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt      @map("updated_at")

  @@map("users")
}

// ── Chatbot: Lead Capture ─────────────────────────────────────────────────────
model ChatbotLead {
  id         String   @id @default(cuid())
  name       String
  phone      String   @unique                    // normalised 10-digit, upsert key
  source     String   @default("chatbot")
  pageUrl    String?  @map("page_url")
  status     String   @default("new")            // "new" | "contacted" | "converted" | "closed"
  notes      String?  @db.Text
  transcript Json?                               // last 10 messages at capture time
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt      @map("updated_at")

  @@map("chatbot_leads")
}

// ── Chatbot: Session Analytics ────────────────────────────────────────────────
model ChatSession {
  id            String   @id @default(cuid())
  sessionId     String   @unique  @map("session_id")
  ipHash        String   @map("ip_hash")
  firstQuestion String?  @map("first_question") @db.Text
  messageCount  Int      @default(0) @map("message_count")
  pageUrl       String?  @map("page_url")
  lastMessageAt DateTime @map("last_message_at")
  createdAt     DateTime @default(now()) @map("created_at")

  @@map("chat_sessions")
}

// ── Contact / Pricing Inquiry Leads ──────────────────────────────────────────
model ContactLead {
  id          String   @id @default(cuid())
  name        String
  phone       String
  email       String?
  service     String?              // from ContactForm ("Web Design", etc.)
  message     String?  @db.Text   // from ContactForm
  plan        String?              // from PricingForm ("basic" | "intermediate" | "premium" | "custom")
  budget      String?              // from PricingForm (numeric string)
  requirement String?  @db.Text   // from PricingForm
  source      String   @default("contact")  // "contact" | "pricing"
  status      String   @default("new")      // "new" | "contacted" | "converted" | "closed"
  notes       String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("contact_leads")
}

// ── Rate Limiting (DB-backed, MySQL) ──────────────────────────────────────────
model RateLimit {
  id        String   @id @default(cuid())
  ipHash    String   @map("ip_hash")
  endpoint  String
  createdAt DateTime @default(now()) @map("created_at")

  @@index([ipHash, endpoint, createdAt])
  @@map("rate_limits")
}

// ── Job Postings (employer submissions → admin approval → placements) ─────────
model JobPosting {
  id             String    @id @default(cuid())
  companyName    String    @map("company_name")
  jobTitle       String    @map("job_title")
  phone          String
  location       String?
  aboutCompany   String?   @map("about_company") @db.Text
  skillsRequired String?   @map("skills_required") @db.Text
  eligibility    String?   @db.Text
  jobTypes       String?   @map("job_types")
  shiftSchedule  String?   @map("shift_schedule")
  status         String    @default("pending") // pending | approved | rejected
  approvedAt     DateTime? @map("approved_at")
  rejectedAt     DateTime? @map("rejected_at")
  adminNotes     String?   @map("admin_notes") @db.Text
  source         String    @default("website") // website | seed
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@index([status, createdAt])
  @@map("job_postings")
}

// ── Gallery albums (events / celebrations) ───────────────────────────────────
model GalleryAlbum {
  id             String         @id @default(cuid())
  title          String
  slug           String         @unique
  description    String?        @db.Text
  coverImage     String?        @map("cover_image")
  seoTitle       String?        @map("seo_title")
  seoDescription String?        @map("seo_description") @db.Text
  allowIndexing  Boolean        @default(true) @map("allow_indexing")
  status         String         @default("draft") // draft | published
  sortOrder      Int            @default(0) @map("sort_order")
  eventDate      DateTime?      @map("event_date")
  publishedAt    DateTime?      @map("published_at")
  wpPostId       Int?           @map("wp_post_id")
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")
  images         GalleryImage[]

  @@index([status, sortOrder])
  @@map("gallery_albums")
}

model GalleryImage {
  id        String       @id @default(cuid())
  albumId   String       @map("album_id")
  album     GalleryAlbum @relation(fields: [albumId], references: [id], onDelete: Cascade)
  src       String
  alt       String?
  caption   String?      @db.Text
  sortOrder Int          @default(0) @map("sort_order")
  createdAt DateTime     @default(now()) @map("created_at")

  @@index([albumId, sortOrder])
  @@map("gallery_images")
}

